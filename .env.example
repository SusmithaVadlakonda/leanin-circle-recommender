# Optional settings, read from the environment. Nothing here is required.
# Example: CIRCLES_DB_PATH=/tmp/circles.db make run

# SQLite database path. Defaults to circles.db at the project root.
CIRCLES_DB_PATH=

# Fixed "now" for activity calculations, as an ISO 8601 timestamp.
# Defaults to the latest timestamp in the data, 2026-09-21T00:00:00Z.
RECOMMENDER_AS_OF=

# Reserved for a future LLM explainer. This version never reads it.
# OPENAI_API_KEY=
